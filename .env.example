# Public origin where the browser opens Shayfin. Include the scheme and external port.
SHAYFIN_ORIGIN=http://localhost:3000

# Host port exposed by Docker Compose.
SHAYFIN_PORT=3000

# Optional fixed first-run code. Leave empty to generate a random code in container logs.
SHAYFIN_SETUP_TOKEN=

# Used by local `npm run dev`; Docker Compose always uses /data inside the container.
SHAYFIN_DATA_DIR=.data
